# Copy to .env.local for development. Inlined into the site at build time.

# Where the forms send to: the Sloka Academy API (sloka-academy-backend), for enquiries and session
# certificates. "/" means this same domain: on Vercel the API runs here, and `npm run dev` forwards
# /api to the API server on port 4000 (override with API_DEV_TARGET). A full URL points at another server.
# Leave unset to hide the Pre-register, Contact, brochure and certificate forms.
NEXT_PUBLIC_API_URL=/
