{
  "name": "sloka-academy-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node --no-warnings scripts/flatten-prefetch.mjs",
    "prebuild": "npm run validate:data && node --no-warnings scripts/generate-sitemap.mjs && node scripts/copy-pdfjs.mjs",
    "predev": "node scripts/copy-pdfjs.mjs",
    "start": "npx serve out",
    "lint": "eslint",
    "validate:data": "node --no-warnings scripts/validate-data.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.5",
    "next": "16.4.2",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
