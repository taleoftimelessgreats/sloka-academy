# Copy to .env and fill in. Real environment variables take precedence over .env.
# On Vercel these are set in the website project's Environment Variables instead (README: Deploying on Vercel).

# HTTP port for the API when run locally (npm run dev). The website forwards /api here in development.
PORT=4000

# REQUIRED: MySQL-compatible database (TiDB Cloud). Use a database of its own (created on first start),
# not a built-in one such as sys. TLS is always used unless you add ?ssl=false (local servers only).
#   mysql://USER:PASSWORD@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/sloka_academy
DATABASE_URL=

# The former SQLite file; only `npm run import-sqlite` reads it (relative to this folder).
DB_PATH=./data/sloka.db

# Optional: database server for `npm test` (each test file creates and drops its own database).
# Defaults to the server in DATABASE_URL. A local TiDB is faster: mysql://root:@127.0.0.1:4000/sloka?ssl=false
TEST_DATABASE_URL=

# REQUIRED: at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Other origins allowed to call the public form endpoints (comma-separated, exact match, no trailing slash).
# Pages on the API's own domain are always allowed, so on Vercel this can stay empty.
ALLOWED_ORIGINS=http://localhost:3000

# Set when running behind a reverse proxy / load balancer so client IPs are correct for rate limiting.
# Use the number of proxy hops (usually 1), or "loopback", or a list of proxy IPs. Leave empty when exposed directly.
# On Vercel it defaults to 1.
TRUST_PROXY=

# Public URL of the staff dashboard, which is part of the website (used for links in notifications).
# Production: https://www.slokaacademy.com/admin/
DASHBOARD_URL=http://localhost:3000/admin/

# Set to "production" in production (enables Secure cookies + HSTS)
NODE_ENV=development

# Recommended so "today" / "overdue" use Indian dates
TZ=Asia/Kolkata

# --- Career guidance certificates ---
# Certificate ID prefix: <PREFIX>-<year>-<8 random chars>, e.g. SLK-2026-7K4M9Q2X (2-8 letters/digits)
CERT_ID_PREFIX=SLK
# Student ID prefix: <PREFIX>-STU-<year>-<number>, e.g. SLK-STU-2026-00042 (2-8 letters/digits).
# Existing IDs never change if you change this later.
STUDENT_ID_PREFIX=SLK
# Website verification page; certificates print "<CERT_VERIFY_URL>?id=<ID>"
CERT_VERIFY_URL=https://www.slokaacademy.com/verify/
# Optional signatory printed on certificates. Leave empty to print just "Sloka Academy".
CERT_SIGNATORY_NAME=
CERT_SIGNATORY_TITLE=
# Public website; the student link shown to staff is <SITE_URL>/certificate/?session=<id>
SITE_URL=https://www.slokaacademy.com
# Public base URL of THIS server, used in emailed certificate download links.
# Optional: defaults to the origin of DASHBOARD_URL (the website, which serves /api). Set it if students should see another hostname.
PUBLIC_API_URL=

# Google Sheets needs no settings here: an admin connects the sheet in the portal (Settings → Google Sheet).

# --- Email (optional) ---
# Emailing certificate PDFs to students needs SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS and NOTIFY_FROM,
# e.g. NOTIFY_FROM="Sloka Academy <certificates@slokaacademy.com>". Gmail/Google Workspace: smtp.gmail.com, 465, an app password.
# New-enquiry team notifications additionally need NOTIFY_TO. Port 465 = implicit TLS; other ports require STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM=
# Comma-separated recipients
NOTIFY_TO=

# Optional Slack / Google Chat incoming-webhook URL (receives {"text": "..."})
NOTIFY_WEBHOOK_URL=
